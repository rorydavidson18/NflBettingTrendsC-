@page
@model ClaudeTest.Pages.Teams.TeamQuery
@{
    ViewData["Title"] = "Teams";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Teams</h2>
        <a href="/Teams/Upsert" class="btn btn-primary">+ New Team</a>
    </div>
    

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="TeamId" class="form-label">ID</label>
            <input id="TeamId" name="TeamId" type="number" min="1" class="form-control"
                   placeholder="e.g. 42"
                   value="@Model.TeamId" />
        </div>

        <div class="col-auto">
            <label for="TeamName" class="form-label">Name</label>
            <input id="TeamName" name="TeamName" type="text" class="form-control"
                   placeholder="Search by name…"
                   value="@Model.TeamName" />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            @if (Model.TeamId.HasValue || !string.IsNullOrWhiteSpace(Model.TeamName))
            {
                <a asp-page="/Teams/Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (Model.TeamId.HasValue || !string.IsNullOrWhiteSpace(Model.TeamName))
    {
        <p class="text-muted">
            <strong>@Model.Teams.Count</strong>
            result@(Model.Teams.Count == 1 ? "" : "s") found
            @if (!string.IsNullOrWhiteSpace(Model.TeamName))
            {
                <span>for "<em>@Model.TeamName</em>"</span>
            }
        </p>
    }

    @if (!Model.Teams.Any())
    {
        <div class="alert alert-info">
            @if (Model.TeamId.HasValue || !string.IsNullOrWhiteSpace(Model.TeamName))
            {
                <p class="mb-0">No items matched your search.</p>
            }
            else
            {
                <p class="mb-0">No items yet — <a asp-page="/Teams/Upsert">create one</a>.</p>
            }
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle text-center sortable-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Abbreviation</th>
                    <th>Conference</th>
                    <th>Division</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Teams)
                {
                    <tr>
                        <td data-sort="@item.Id"><span class="badge bg-secondary">#@item.Id</span></td>
                        <td>@item.Name</td>
                        <td>@item.Abbreviation</td>
                        <td>@item.Division.Conference.Name</td>
                        <td>@item.Division.Name</td>
                        <td><a href="/Games/GameQuery?Team1=@item.Abbreviation" class="btn btn-sm btn-outline-primary">Games</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>