@page
@model ClaudeTest.Pages.Games.GamesInsert
@{
    ViewData["Title"] = "Games Insert";
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="@Model.HomeTeamAbv" class="form-label">Home Team: </label>
        <input asp-for="@Model.HomeTeamAbv" class="form-control"/>
        <span asp-validation-for="@Model.HomeTeamAbv" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.AwayTeamAbv" class="form-label">Away Team: </label>
        <input asp-for="@Model.AwayTeamAbv" class="form-control"/>
        <span asp-validation-for="@Model.HomeTeamAbv" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.Date" class="form-label">Date: </label>
        <input asp-for="@Model.Date" type="date" class="form-control"/>
        <span asp-validation-for="@Model.Date" class="date-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.HomeScore" class="form-label">Home Score: </label>
        <input asp-for="@Model.HomeScore" class="form-control" type="number" step="1" min="0"/>
        <span asp-validation-for="@Model.HomeScore" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.AwayScore" class="form-label">Away Score: </label>
        <input asp-for="@Model.AwayScore" class="form-control" type="number" step="1" min="0"/>
        <span asp-validation-for="@Model.AwayScore" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.Spread" class="form-label">Spread: </label>
        <input asp-for="@Model.Spread" class="form-control" type="number" step="0.5" min="-100"/>
        <span asp-validation-for="@Model.Spread" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="@Model.Total" class="form-label">Total: </label>
        <input asp-for="@Model.Total" class="form-control" type="number" step="0.5" min="0"/>
        <span asp-validation-for="@Model.Total" class="field-error"></span>
    </div>

    <div class="form-check-row">
        <label asp-for="@Model.PlayoffGame" class="form-label">Playoff Game: </label>
        <input type="hidden" name="@Model.PlayoffGame" value="false"/>
        <input asp-for="@Model.PlayoffGame" type="checkbox"/>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div>Message</div>
    }

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/Games/GamesInsert" class="btn btn-secondary">Cancel</a>
</form>