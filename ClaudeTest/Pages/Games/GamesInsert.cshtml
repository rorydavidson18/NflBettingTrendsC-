@page "{id:int?}"
@model ClaudeTest.Pages.Games.GamesInsert
@{
    ViewData["Title"] = "Games Insert";
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Game.Id" />

    <div class="mb-3">
        <label for="HomeTeamAbv" class="form-label">Home Team: </label>
        <input asp-for="Game.HomeTeamAbv" class="form-control" id="HomeTeamAbv"/>
        @* <span asp-validation-for="Game.HomeTeamAbv" class="text-danger"></span> *@
    </div>

    <div class="mb-3">
        <label for="AwayTeamAbv" class="form-label">Away Team: </label>
        <input asp-for="Game.AwayTeamAbv" class="form-control" id="AwayTeamAbv"/>
        @* <span asp-validation-for="Game.HomeTeamAbv" class="text-danger"></span> *@
    </div>

    <div class="mb-3">
        <label for="Date" class="form-label">Date: </label>
        <input asp-for="Game.Date" type="date" class="form-control" id="Date"/>
        @* <span asp-validation-for="Game.Date" class="date-danger"></span> *@
    </div>

    <div class="mb-3">
        <label for="HomeScore" class="form-label">Home Score: </label>
        <input asp-for="Game.HomeScore" class="form-control" type="number" step="1" min="0" id="HomeScore"/>
        @* <span asp-validation-for="Game.HomeScore" class="field-error"></span> *@
    </div>

    <div class="mb-3">
        <label for="AwayScore" class="form-label">Away Score: </label>
        <input asp-for="Game.AwayScore" class="form-control" type="number" step="1" min="0" id="AwayScore"/>
        @* <span asp-validation-for="Game.AwayScore" class="field-error"></span> *@
    </div>

    <div class="mb-3">
        <label for="Spread" class="form-label">Spread: </label>
        <input asp-for="Game.Spread" class="form-control" type="number" step="0.5" min="-100" id="Spread"/>
        @* <span asp-validation-for="Game.Spread" class="field-error"></span> *@
    </div>

    <div class="mb-3">
        <label for="Total" class="form-label">Total: </label>
        <input asp-for="Game.Total" class="form-control" type="number" step="0.5" min="0" id="Total"/>
        @* <span asp-validation-for="Game.Total" class="field-error"></span> *@
    </div>

    <div class="form-check-row">
        <label for="PlayoffGame" class="form-label">Playoff Game: </label>
        <input type="hidden" name="Game.PlayoffGame" value="false"/>
        <input asp-for="Game.PlayoffGame" type="checkbox" id="PlayoffGame"/>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div>@Model.Message</div>
    }

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/Games/GamesInsert" class="btn btn-secondary">Cancel</a>
</form>