@page "{id:int?}"
@model ClaudeTest.Pages.Games.GamesInsert
@{
    ViewData["Title"] = "Games Insert";
}

<div class="container py-4">
    <h2 class="mb-3">New Game</h2>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Game.Id" />

        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="HomeTeamAbv" class="form-label mb-0">Home Team</label>
                <input asp-for="Game.HomeTeamAbv" class="form-control form-control-sm" style="width: 110px" id="HomeTeamAbv"/>
                @* <span asp-validation-for="Game.HomeTeamAbv" class="text-danger"></span> *@
            </div>

            <div class="col-auto">
                <label for="AwayTeamAbv" class="form-label mb-0">Away Team</label>
                <input asp-for="Game.AwayTeamAbv" class="form-control form-control-sm" style="width: 110px" id="AwayTeamAbv"/>
                @* <span asp-validation-for="Game.HomeTeamAbv" class="text-danger"></span> *@
            </div>

            <div class="col-auto">
                <label for="Date" class="form-label mb-0">Date</label>
                <input asp-for="Game.Date" type="date" class="form-control form-control-sm" id="Date"/>
                @* <span asp-validation-for="Game.Date" class="date-danger"></span> *@
            </div>
        </div>

        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="HomeScore" class="form-label mb-0">Home Score</label>
                <input asp-for="Game.HomeScore" class="form-control form-control-sm" style="width: 90px" type="number" step="1" min="0" id="HomeScore"/>
                @* <span asp-validation-for="Game.HomeScore" class="field-error"></span> *@
            </div>

            <div class="col-auto">
                <label for="AwayScore" class="form-label mb-0">Away Score</label>
                <input asp-for="Game.AwayScore" class="form-control form-control-sm" style="width: 90px" type="number" step="1" min="0" id="AwayScore"/>
                @* <span asp-validation-for="Game.AwayScore" class="field-error"></span> *@
            </div>
        </div>

        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="Spread" class="form-label mb-0">Spread</label>
                <input asp-for="Game.Spread" class="form-control form-control-sm" style="width: 90px" type="number" step="0.5" min="-100" id="Spread"/>
                @* <span asp-validation-for="Game.Spread" class="field-error"></span> *@
            </div>

            <div class="col-auto">
                <label for="Total" class="form-label mb-0">Total</label>
                <input asp-for="Game.Total" class="form-control form-control-sm" style="width: 90px" type="number" step="0.5" min="0" id="Total"/>
                @* <span asp-validation-for="Game.Total" class="field-error"></span> *@
            </div>
        </div>

        <div class="row g-2 align-items-center mb-3">
            <div class="col-auto form-check">
                <input type="hidden" name="Game.PlayoffGame" value="false"/>
                <input asp-for="Game.PlayoffGame" type="checkbox" class="form-check-input" id="PlayoffGame"/>
                <label for="PlayoffGame" class="form-check-label">Playoff Game</label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="mb-3">@Model.Message</div>
        }

        <button type="submit" class="btn btn-success">Save</button>
        <a href="/Games/GameQuery" class="btn btn-secondary">Cancel</a>
    </form>
</div>