@page
@model ClaudeTest.Pages.Games.GameQuery
@{
    ViewData["Title"] = "Games";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Games</h2>
        <a href="/Games/GamesInsert" class="btn btn-primary">+ New Game</a>
    </div>

    <form method="get">
        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="GameId" class="form-label mb-0">ID</label>
                <input id="GameId" name="GameId" type="number" min="1"
                       placeholder="e.g. 42"
                       class="form-control form-control-sm" style="width: 90px"
                       asp-for="GameId"/>
            </div>

            <div class="col-auto">
                <label for="Team1" class="form-label mb-0">Team 1</label>
                <input id="Team1" name="Team1" type="text"
                       placeholder="e.g. NE"
                       class="form-control form-control-sm" style="width: 110px"
                       asp-for="Team1"/>
            </div>

            <div class="col-auto">
                <label for="Team2" class="form-label mb-0">Team 2</label>
                <input id="Team2" name="Team2" type="text"
                       placeholder="e.g. NE"
                       class="form-control form-control-sm" style="width: 110px"
                       asp-for="Team2"/>
            </div>

            <div class="col-auto">
                <label for="CareAboutHomeAndAway" class="form-label mb-0">Home/Away</label>
                <select id="CareAboutHomeAndAway" name="CareAboutHomeAndAway" class="form-select form-select-sm" style="width: 110px">
                    <option value="false" selected="@(!Model.CareAboutHomeAndAway ? "selected" : null)">False
                    </option>
                    <option value="true" selected="@(Model.CareAboutHomeAndAway ? "selected" : null)">True
                    </option>
                </select>
            </div>
        </div>

        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="StartDate" class="form-label mb-0">From</label>
                <input asp-for="StartDate" type="date" class="form-control form-control-sm" id="StartDate"/>
            </div>
            <div class="col-auto">
                <label for="EndDate" class="form-label mb-0">To</label>
                <input asp-for="EndDate" type="date" class="form-control form-control-sm" id="EndDate"/>
                @* <span asp-validation-for="Game.Date" class="date-danger"></span> *@
            </div>
        </div>

        <div class="row row-cols-auto g-2 align-items-end mb-2">
            <div class="col-auto">
                <label for="Spread" class="form-label mb-0">Spread</label>
                <input id="Spread" name="Spread" type="number" min="1"
                       placeholder="e.g. 2.5"
                       class="form-control form-control-sm" style="width: 90px"
                       value="@Model.Spread"/>
            </div>

            <div class="col-auto">
                <label for="SpreadGreaterThanOrEqualTo" class="form-label mb-0">Spread Comparator</label>
                <select id="SpreadGreaterThanOrEqualTo" name="SpreadGreaterThanOrEqualTo" class="form-select form-select-sm" style="width: 140px">
                    <option value="true" selected="@(Model.SpreadGreaterThanOrEqualTo ? "selected" : null)">
                        Greater Than
                    </option>
                    <option value="false" selected="@(!Model.SpreadGreaterThanOrEqualTo ? "selected" : null)">
                        Less Than
                    </option>
                </select>
            </div>

            <div class="col-auto">
                <label for="Total" class="form-label mb-0">Total</label>
                <input id="Total" name="Total" type="number" min="1"
                       placeholder="e.g. 2.5"
                       class="form-control form-control-sm" style="width: 90px"
                       value="@Model.Total"/>
            </div>

            <div class="col-auto">
                <label for="TotalGreaterThanOrEqualTo" class="form-label mb-0">Total Comparator</label>
                <select id="TotalGreaterThanOrEqualTo" name="TotalGreaterThanOrEqualTo" class="form-select form-select-sm" style="width: 140px">
                    <option value="true" selected="@(Model.TotalGreaterThanOrEqualTo ? "selected" : null)">
                        Greater Than
                    </option>
                    <option value="false" selected="@(!Model.TotalGreaterThanOrEqualTo ? "selected" : null)">
                        Less Than
                    </option>
                </select>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
            </div>
            @if (Model.GameId.HasValue ||
                 !string.IsNullOrWhiteSpace(Model.Team1) ||
                 !string.IsNullOrWhiteSpace(Model.Team2) ||
                 Model.Spread.HasValue ||
                 Model.Total.HasValue)
            {
                <div class="col-auto">
                    <a asp-page="/Games/Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                </div>
            }
        </div>
    </form>

    <!-- Result count -->
    @if (Model.GameId.HasValue ||
         !string.IsNullOrWhiteSpace(Model.Team1) ||
         !string.IsNullOrWhiteSpace(Model.Team2) ||
         Model.Spread.HasValue ||
         Model.Total.HasValue)
    {
        <p class="text-muted mt-3">
            <strong>@Model.Games.Count</strong>
            result@(Model.Games.Count == 1 ? "" : "s") found
            <span>for GameId: "<em>@Model.GameId</em>" and Team1: "<em>@Model.Team1</em>" and Team 2: "<em>@Model.Team2</em>" and Spread: "<em>@Model.Spread</em>" and Total: "<em>@Model.Total</em>"</span>
        </p>
    }

    <p>Home Teams cover @Model.Trends.SpreadPercentage% of the time</p>
    <p>The Over hits @Model.Trends.TotalPercentage% of the time</p>

    <!-- ATS by spread range -->
    @if (Model.Games.Any())
    {
        <div class="mb-4">
            <div id="atsBinChart"></div>
        </div>
    }

    <!-- Table -->
    @if (!Model.Games.Any())
    {
        <div class="alert alert-info">
            @if (Model.GameId.HasValue ||
                 !string.IsNullOrWhiteSpace(Model.Team1) ||
                 !string.IsNullOrWhiteSpace(Model.Team2) ||
                 Model.Spread.HasValue ||
                 Model.Total.HasValue)
            {
                <p class="mb-0">No items matched your search.</p>
            }
            else
            {
                <p class="mb-0">No items yet — <a asp-page="/Games/GamesInsert">create one</a>.</p>
            }
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle text-center sortable-table">
            <thead>
            <tr>
                <th>ID</th>
                <th>HomeTeam</th>
                <th>AwayTeam</th>
                <th>Date</th>
                <th>HomeScore</th>
                <th>AwayScore</th>
                <th>Spread</th>
                <th>SpreadResult</th>
                <th>Total</th>
                <th>TotalResult</th>
                <th>PlayoffGame</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Games)
            {
                <tr>
                    <td data-sort="@item.Id"><span class="badge bg-secondary">#@item.Id</span></td>
                    <td>@item.HomeTeam.Abbreviation</td>
                    <td>@item.AwayTeam.Abbreviation</td>
                    <td data-sort="@item.Date.Ticks">@item.Date</td>
                    <td>@item.HomeScore</td>
                    <td>@item.AwayScore</td>
                    <td>@item.Spread</td>
                    <td data-sort="@item.SpreadResult">@item.SpreadResultString</td>
                    <td>@item.Total</td>
                    <td data-sort="@item.TotalResult">@item.TotalResultString</td>
                    <td>@item.PlayoffGame</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    @if (Model.Games.Any())
    {
        <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
        <script>
            (function () {
                const bins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AtsBins,
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }));

                const labels = bins.map(b => b.label);
                const maxCount = Math.max(...bins.map(b => b.gameCount), 1);

                const widths = bins.map(b => b.gameCount === 0 ? 0.15 : 0.3 + 0.6 * (b.gameCount / maxCount));
                const opacities = bins.map(b => b.gameCount === 0 ? 0.15 : 0.3 + 0.7 * (b.gameCount / maxCount));
                const colors = bins.map(b => b.gameCount === 0
                    ? '#adb5bd'
                    : (b.coverPercentage >= 50 ? '#198754' : '#dc3545'));
                const text = bins.map(b => `<b>n=${b.gameCount}</b>`);

                const trace = {
                    x: labels,
                    y: bins.map(b => b.coverPercentage),
                    type: 'bar',
                    width: widths,
                    text: text,
                    textposition: 'outside',
                    textfont: {
                        size: 14,
                        color: '#212529'
                    },
                    cliponaxis: false,
                    marker: {
                        color: colors,
                        opacity: opacities
                    },
                    hovertemplate: '%{x}<br>Home ATS: %{y:.1f}%<br>%{text}<extra></extra>'
                };

                const layout = {
                    title: 'Home Team ATS Cover % by Spread Range',
                    xaxis: {
                        categoryorder: 'array',
                        categoryarray: labels,
                        tickangle: -45,
                        title: 'Spread range (home underdog ← → home favorite)'
                    },
                    yaxis: {
                        title: 'Home ATS Cover %',
                        range: [0, 112]
                    },
                    shapes: [{
                        type: 'line',
                        x0: 0,
                        x1: 1,
                        xref: 'paper',
                        y0: 53,
                        y1: 53,
                        line: { color: '#6c757d', dash: 'dash', width: 1 }
                    }],
                    margin: { t: 50, b: 120 }
                };

                Plotly.newPlot('atsBinChart', [trace], layout, { responsive: true });
            })();
        </script>
    }
}

