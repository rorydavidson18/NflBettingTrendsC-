@page
@model ClaudeTest.Pages.Games.GameQuery
@{
    ViewData["Title"] = "Games";
}

<head>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
            text-align: center;
            padding: 15px;
        }
    </style>
    <title>Games</title>
</head>

<div class="items-wrap">
    <div class="items-header">
        <h2 class="items-title">Games</h2>
        <a href="/Games/Upsert" class="btn btn-primary mb-3">+ New Game</a>
    </div>

    <!-- Search Form -->
    <form method="get">
        <div class="search-bar">
            <div class="search-field search-field--id">
                <label for="GameId">ID</label>
                <input id="GameId" name="GameId" type="number" min="1"
                       placeholder="e.g. 42"
                       value="@Model.GameId"/>
            </div>

            <div class="search-field search-field--name">
                <label for="Team1">Team 1 Abbreviation</label>
                <input id="Team1" name="Team1" type="text"
                       placeholder="Search by name…"
                       value="@Model.Team1"/>
            </div>

            <div class="search-field search-field--name">
                <label for="Team2">Team 2 Abbreviation</label>
                <input id="Team2" name="Team2" type="text"
                       placeholder="Search by name…"
                       value="@Model.Team2"/>
            </div>

            @* <div class="form-check"> *@
            @*     <label class="form-check-label" for="CareAboutHomeAndAway">CareAboutHomeAndAway</label> *@
            @*     <input type="hidden" name="CareAboutHomeAndAway" value="false" /> *@
            @*     <input type="checkbox" name="CareAboutHomeAndAway" class="form-check-input"  *@
            @*            id="CareAboutHomeAndAway" value="@Model.CareAboutHomeAndAway"/> *@
            @* </div> *@
            <div class="search-field">
                <label for="CareAboutHomeAndAway">CareAboutHomeAndAway</label>
                <select id="CareAboutHomeAndAway" name="CareAboutHomeAndAway" class="form-select">
                    <option value="true" selected="@(Model.CareAboutHomeAndAway == true ? "selected" : null)">True
                    </option>
                    <option value="false" selected="@(Model.CareAboutHomeAndAway == false ? "selected" : null)">False
                    </option>
                </select>
            </div>

            <div class="search-field search-field--id">
                <label for="Spread">Spread</label>
                <input id="Spread" name="Spread" type="number" min="1"
                       placeholder="e.g. 2.5"
                       value="@Model.Spread"/>
            </div>

            <div class="search-field">
                <label for="SpreadGreaterThanOrEqualTo">Spread Comparator</label>
                <select id="SpreadGreaterThanOrEqualTo" name="SpreadGreaterThanOrEqualTo" class="form-select">
                    <option value="true" selected="@(Model.SpreadGreaterThanOrEqualTo == true ? "selected" : null)">
                        Greater Than
                    </option>
                    <option value="false" selected="@(Model.SpreadGreaterThanOrEqualTo == false ? "selected" : null)">
                        Less Than
                    </option>
                </select>
            </div>

            <div class="search-field search-field--id">
                <label for="Total">Total</label>
                <input id="Total" name="Total" type="number" min="1"
                       placeholder="e.g. 2.5"
                       value="@Model.Total"/>
            </div>
            
            <div class="search-field">
                <label for="TotalGreaterThanOrEqualTo">Total Comparator</label>
                <select id="TotalGreaterThanOrEqualTo" name="TotalGreaterThanOrEqualTo" class="form-select">
                    <option value="true" selected="@(Model.TotalGreaterThanOrEqualTo == true ? "selected" : null)">
                        Greater Than
                    </option>
                    <option value="false" selected="@(Model.TotalGreaterThanOrEqualTo == false ? "selected" : null)">
                        Less Than
                    </option>
                </select>
            </div>

            <div class="search-actions">
                <button type="submit" class="btn-search">Search</button>
                @if (Model.GameId.HasValue ||
                     !string.IsNullOrWhiteSpace(Model.Team1) ||
                     !string.IsNullOrWhiteSpace(Model.Team2) ||
                     Model.Spread.HasValue ||
                     Model.Total.HasValue)
                {
                    <a asp-page="/Games/Index" class="btn-clear">Clear</a>
                }
            </div>
        </div>
    </form>

    <!-- Result count -->
    @if (Model.GameId.HasValue ||
         !string.IsNullOrWhiteSpace(Model.Team1) ||
         !string.IsNullOrWhiteSpace(Model.Team2) ||
         Model.Spread.HasValue ||
         Model.Total.HasValue)
    {
        <p class="result-meta">
            <strong>@Model.Games.Count</strong>
            result@(Model.Games.Count == 1 ? "" : "s") found
            <span>for GameId: "<em>@Model.GameId</em>" and Team1: "<em>@Model.Team1</em>" and Team 2: "<em>@Model.Team2</em>" and Spread: "<em>@Model.Spread</em>" and Total: "<em>@Model.Total</em>"</span>
        </p>
    }

    <!-- Table -->
    @if (!Model.Games.Any())
    {
        <div class="empty-state">
            @if (Model.GameId.HasValue ||
                 !string.IsNullOrWhiteSpace(Model.Team1) ||
                 !string.IsNullOrWhiteSpace(Model.Team2) ||
                 Model.Spread.HasValue ||
                 Model.Total.HasValue)
            {
                <p>No items matched your search.</p>
            }
            else
            {
                <p>No items yet — <a asp-page="/Games/Upsert">create one</a>.</p>
            }
        </div>
    }
    else
    {
        <table class="table table-striped">
            @* <table class="items-table"> *@
            <thead>
            <tr>
                <th>ID</th>
                <th>HomeTeam</th>
                <th>AwayTeam</th>
                <th>Date</th>
                <th>HomeScore</th>
                <th>AwayScore</th>
                <th>Spread</th>
                <th>SpreadResult</th>
                <th>Total</th>
                <th>TotalResult</th>
                <th>PlayoffGame</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Games)
            {
                <tr>
                    <td><span class="id-badge">#@item.Id</span></td>
                    <td>@item.HomeTeam.Abbreviation</td>
                    <td>@item.AwayTeam.Abbreviation</td>
                    <td>@item.Date</td>
                    <td>@item.HomeScore</td>
                    <td>@item.AwayScore</td>
                    <td>@item.Spread</td>
                    <td>@item.SpreadResultString</td>
                    <td>@item.Total</td>
                    <td>@item.TotalResultString</td>
                    <td>@item.PlayoffGame</td>
                    <td><a href="/Games/Upsert?id=@item.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>