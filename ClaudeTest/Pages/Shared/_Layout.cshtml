<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>
<body>

<div class="site-nav">
    <a class="nav-brand" asp-page="/Index">Your Name</a>
    <ul class="nav-links">
        <li><a asp-page="/Index"
               class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
            Home
        </a></li>
        <li><a asp-page="/Teams/TeamQuery"
               class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Team/TeamQuery") == true ? "active" : "")">
            Teams
        </a></li>
        <li><a asp-page="/Games/GameQuery"
               class="@(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Games/GameQuery") == true ? "active" : "")">
            Games
        </a></li>
        <li><a asp-page="/About">About</a></li>
    </ul>
</div>

<main>
    @RenderBody()
</main>

<footer>
    <span>© @DateTime.Now.Year Your Name</span>
    <span>Built with ASP.NET &amp; Azure</span>
</footer>

@RenderSection("Scripts", required: false)

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>