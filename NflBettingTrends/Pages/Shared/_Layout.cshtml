<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap"
          rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
            text-align: center;
            padding: 15px;
        }

        th.sortable-column {
            cursor: pointer;
            user-select: none;
        }

        th.sortable-column::after {
            content: '↕';
            opacity: 0.4;
            margin-left: 6px;
            font-size: 0.8em;
        }

        th.sortable-column.sort-asc::after {
            content: '▲';
            opacity: 1;
        }

        th.sortable-column.sort-desc::after {
            content: '▼';
            opacity: 1;
        }
    </style>
</head>
<body>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

<nav class="navbar navbar-expand navbar-light bg-light border-bottom">
    <div class="container">
        <a class="navbar-brand" asp-page="/Index">NFL Betting Trends</a>

        <div class="dropdown ms-auto">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                Menu
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item @(currentPage == "/Index" ? "active" : "")"
                       asp-page="/Index">Home</a></li>
                <li><a class="dropdown-item @(currentPage?.StartsWith("/Teams/TeamQuery") == true ? "active" : "")"
                       asp-page="/Teams/TeamQuery">Teams</a></li>
                <li><a class="dropdown-item @(currentPage?.StartsWith("/Games/GameQuery") == true ? "active" : "")"
                       asp-page="/Games/GameQuery">Games</a></li>
                <li><a class="dropdown-item" asp-page="/About">About</a></li>

                <li>
                    <hr class="dropdown-divider"/>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* @if (User.IsInRole("BetTracker") || User.IsInRole("Admin")) *@
                    @* { *@
                    <li>
                        <a class="dropdown-item @(currentPage?.StartsWith("/Bets") == true ? "active" : "")"
                           asp-page="/Bets/BetInsert">My Bets
                        </a>
                    </li>
                    // }

                    <li>
                        <a class="dropdown-item text-danger"
                           asp-area="MicrosoftIdentity"
                           asp-controller="Account"
                           asp-action="SignOut">
                            Sign Out (@User.Identity.Name)
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a class="dropdown-item"
                           asp-area="MicrosoftIdentity"
                           asp-controller="Account"
                           asp-action="SignIn">
                            Sign In
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer>
    <span>© @DateTime.Now.Year Your Name</span>
    <span>Built with ASP.NET &amp; Azure</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="~/js/table-sort.js"></script>

@RenderSection("Scripts", required: false)
</body>
</html>